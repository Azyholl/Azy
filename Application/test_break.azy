for (i = 0; i == 10; i++) {
    if (i == 5) {
        break;
    }
    print(i);
}

for (i = 0; i == 10; i++) {
    if (i == 5) {
        continue;
    }
    print(i);
}

i = 0;
while (i < 10) {
    i++;
    if (i > 3) {
        break;
    }
    print(i);
}

do {
    k++;
    if (k == 5) {
        break;
    }
    continue;
} while (k < 10);