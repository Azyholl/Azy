# ============================================================
#  Полный тест парсера языка Azy
#  Всё, что закомментировано, — ещё не реализовано
# ============================================================

# ------------------------------------------------------------
# 1. КОММЕНТАРИИ (все три вида)
# ------------------------------------------------------------
# Это однострочный комментарий через решётку
// Это однострочный комментарий через двойной слэш
/* Это
   многострочный
   комментарий */

# ------------------------------------------------------------
# 2. ЛИТЕРАЛЫ
# ------------------------------------------------------------
i    = 42;          # int
f    = 3.14;        # float
f2   = .5;          # float, начинается с точки
s    = "Hello, Azy!";   # string
t    = true;        # bool
fa   = false;       # bool

# ------------------------------------------------------------
# 3. ПРИСВАИВАНИЯ — все операторы
# ------------------------------------------------------------
a  = 10;
a += 5;             # +=
a -= 3;             # -=
a *= 2;             # *=
a /= 4;             # /=

# ------------------------------------------------------------
# 4. АРИФМЕТИКА И ПРИОРИТЕТ
# ------------------------------------------------------------
x = 2 + 3 * 4;              # 14, а не 20
y = (2 + 3) * 4;            # 20
z = 10 - 5 - 2;             # 3 (слева направо)
w = 20 / 4 / 5;             # 1
neg = -5;                   # унарный минус
mixed = -3 * -2 + 10;       # унарные минусы в выражениях

# ------------------------------------------------------------
# 5. ЛОГИЧЕСКИЕ И СРАВНЕНИЯ
# ------------------------------------------------------------
c1 = a == 10;
c2 = a != 5;
c3 = a < 100;
c4 = a > 1;
c5 = a <= 10;
c6 = a >= 10;
c7 = true && false;
c8 = true || false;
c9 = !true;
c10 = not false;
c11 = (a > 5) && (f < 10.0) || (s == "x");
c12 = !(a == 10) || !(b != 0);

# ------------------------------------------------------------
# 6. УНАРНЫЕ И ПОСТФИКСНЫЕ ++ / --
# ------------------------------------------------------------
counter = 0;
counter++;                  # постфиксный ++
counter--;                  # постфиксный --
# ++counter;                # TODO: префиксный ++ (не реализован в parseUnary)
# --counter;                # TODO: префиксный -- (не реализован в parseUnary)
value = -counter;           # унарный минус как часть выражения

# ------------------------------------------------------------
# 7. IF / ELSE / ELSE IF
# ------------------------------------------------------------
if (a == 10) {
    message = "a равно 10";
}

if (a > 100) {
    message = "больше";
} else {
    message = "не больше";
}

if (a == 1) {
    r = "one";
} else if (a == 2) {
    r = "two";
} else if (a == 3) {
    r = "three";
} else {
    r = "other";
}

# Вложенные if
if (a > 0) {
    if (a > 100) {
        big = true;
    } else {
        big = false;
    }
}

# ------------------------------------------------------------
# 8. WHILE
# ------------------------------------------------------------
i = 0;
while (i < 10) {
    i++;
}

# while с несколькими операторами
j = 10;
sum = 0;
while (j > 0) {
    sum += j;
    j--;
}

# ------------------------------------------------------------
# 9. DO ... WHILE
# ------------------------------------------------------------
k = 0;
do {
    k++;
} while (k < 5);

# do...while с телом из нескольких операторов
n = 3;
fact = 1;
do {
    fact *= n;
    n--;
} while (n > 1);

# ------------------------------------------------------------
# 10. FOR — ФОРМА 1 (сокращённая: for (i == N))
# ------------------------------------------------------------
for (i == 5) {
    print(i);
}

# сокращённая с телом из нескольких операторов
for (i == 3) {
    print(i);
    print.ln(i * 2);
}

# ------------------------------------------------------------
# 11. FOR — ФОРМА 2 (полная C-style)
# ------------------------------------------------------------
for (i = 0; i == 10; i++) {
    print(i);
}

# полная с другим шагом (i = i + 2)
for (i = 0; i == 10; i = i + 2) {
    print(i);
}

# полная с вложенным if
for (i = 0; i == 10; i++) {
    if (i == 5) {
        print.ln("половина");
    }
}

# ------------------------------------------------------------
# 12. FOR — ФОРМА 3 (foreach: for (x in ...))
# ------------------------------------------------------------
text = "abc";
for (ch in text) {
    print(ch);
}

# foreach по строковой переменной
name = "Azy";
for (c in name) {
    print.ln(c);
}

# ------------------------------------------------------------
# 13. PRINT и PRINT.LN
# ------------------------------------------------------------
print("без переноса");
print.ln("с переносом строки");
print(42);
print.ln(3.14);
print(true);
print(a + b * 2);

# print с выражением
print((10 + 5) * 2);
print.ln("Результат: ");
print(42);

# ------------------------------------------------------------
# 14. ВЛОЖЕННЫЕ КОНСТРУКЦИИ
# ------------------------------------------------------------
for (i = 0; i == 3; i++) {
    j = 0;
    while (j < 3) {
        if (i == j) {
            print.ln("диагональ");
        } else {
            print(".");
        }
        j++;
    }
    print.ln("");
}

# ------------------------------------------------------------
# 15. СЛОЖНЫЕ ВЫРАЖЕНИЯ
# ------------------------------------------------------------
result = ((2 + 3) * (4 - 1)) / ((10 / 2) + 1);
cond   = (a > 5) && ((f < 10.0) || (s != "none")) && !(t == fa);

